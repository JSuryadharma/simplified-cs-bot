# Semua service bot berjalan lewat compose.yaml (make up); database ada di compose SaViOr.
# URL antar-service (Qdrant, PostgREST, WhatsApp mock) sudah diatur di compose.yaml.
# Database bot memakai Postgres milik aplikasi web SaViOr (../GitHub/savior-app/compose.yaml).
# Role wa_admin dibuat oleh `make db-init` / `make db-move` dengan password di bawah.
POSTGRES_USER=wa_admin
POSTGRES_PASSWORD=ganti_dengan_password_database_yang_kuat
SAVIOR_DB_HOST=savior-postgres
SAVIOR_DB_NAME=savior
# Jaringan Docker compose SaViOr (nama folder + "_default")
SAVIOR_NETWORK=savior-app_default
N8N_ENCRYPTION_KEY=ganti_dengan_string_acak_minimal_32_karakter
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_PUBLIC_URL=http://localhost:5678
# URL publik n8n (domain ngrok statis atau domain sendiri), diakhiri "/"
WEBHOOK_URL=https://domain-anda.ngrok-free.dev/
N8N_WEBHOOK_URL=https://domain-anda.ngrok-free.dev/

# Tunnel ngrok di dalam compose (service "tunnel"). Kosongkan COMPOSE_PROFILES bila
# memakai reverse proxy/domain sendiri. Token: https://dashboard.ngrok.com
COMPOSE_PROFILES=tunnel
NGROK_AUTHTOKEN=ganti_dengan_authtoken_ngrok
NGROK_DOMAIN=domain-anda.ngrok-free.dev
GENERIC_TIMEZONE=Asia/Jakarta

# LM Studio. Dari container Docker, localhost milik container sehingga alamat host
# harus memakai host.docker.internal. Jika n8n dijalankan tanpa Docker, pakai
# http://127.0.0.1:1234/v1 seperti alamat yang diberikan.
LM_STUDIO_BASE_URL=http://host.docker.internal:1234/v1
LM_STUDIO_API_TOKEN=lm-studio
LM_STUDIO_CHAT_MODEL=google/gemma-4-e2b
LM_STUDIO_EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5

# Model OpenRouter untuk node AI Agent (keputusan AUTO_REPLY/ESCALATE).
# Credential n8n "OpenAI account" harus diarahkan ke Base URL
# https://openrouter.ai/api/v1 dengan API key OpenRouter asli.
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# Isi untuk memakai OpenRouter (mis. model gratis qwen/qwen3.8-27b:free)
OPENROUTER_API_KEY=

# Alamat dari host (scripts/doctor.mjs). Di dalam compose, n8n otomatis memakai
# http://qdrant:6333 dan http://db-api:3000.
QDRANT_URL=http://localhost:6333
DB_API_URL=http://localhost:3002

# Versi Graph API Meta
WHATSAPP_GRAPH_VERSION=v23.0

# Vector database
QDRANT_COLLECTION=wa_knowledge
QDRANT_SCORE_THRESHOLD=0.6

# Pengiriman keluar memakai node native WhatsApp Business Cloud. Simpan access token
# dan WhatsApp Business Account ID di credential n8n bernama "WhatsApp account".
# Environment berikut hanya dipakai untuk verifikasi webhook masuk.
WHATSAPP_VERIFY_TOKEN=ganti_token_verifikasi_webhook_meta
WHATSAPP_APP_SECRET=

# Nomor hanya angka dengan kode negara, tanpa tanda +. Nomor ini mengirim perintah
# admin dan balasan tiket dari akun WhatsApp pribadi owner ke nomor bisnis.
OWNER_PHONE=628xxxxxxxxxx
OWNER_NAME=Owner

# Melindungi webhook admin untuk impor chat dan sinkronisasi order.
IMPORT_API_KEY=ganti_kunci_import_acak

# Dashboard admin NodeJS (port 4000). Balasan tiket dari dashboard dikirim
# langsung ke pelanggan. Isi credential WhatsApp Cloud API berikut, atau biarkan
# kosong dan arahkan MOCK_WHATSAPP_URL ke gateway mock untuk pengembangan lokal.
WHATSAPP_ACCESS_TOKEN=dev-token
WHATSAPP_PHONE_NUMBER_ID=demo-phone-number-id

# Rahasia bersama dashboard tiket -> webhook n8n dashboard-send (openssl rand -hex 24)
DASHBOARD_SEND_SECRET=ganti_rahasia_dashboard
