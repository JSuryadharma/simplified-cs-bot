# Semua service bot berjalan lewat compose.yaml (make up); database ada di compose SaViOr.
# URL antar-service (Qdrant, PostgREST, WhatsApp mock) sudah diatur di compose.yaml.
# Database bot memakai Postgres milik aplikasi web SaViOr (../GitHub/savior-app/compose.yaml).
# User dan password sama dengan compose SaViOr (POSTGRES_USER/POSTGRES_PASSWORD di
# ../GitHub/savior-app/compose.yaml). Isi password database SaViOr di server.
POSTGRES_USER=savior
POSTGRES_PASSWORD=ganti_dengan_password_postgres_savior
SAVIOR_DB_HOST=savior-postgres
SAVIOR_DB_NAME=savior
# Jaringan Docker compose SaViOr (nama folder + "_default")
SAVIOR_NETWORK=savior-app_default
N8N_ENCRYPTION_KEY=ganti_dengan_string_acak_minimal_32_karakter
# --- URL publik & port tiap service ---------------------------------------------
# n8n di belakang nginx: https://jsur.site/n8n/ (blok nginx: docs/nginx.example.conf).
# Untuk lokal tanpa nginx: N8N_HOST=localhost, N8N_PROTOCOL=http, N8N_PATH=/,
# WEBHOOK_URL=http://localhost:5678/, N8N_EDITOR_BASE_URL=, N8N_PROXY_HOPS=0,
# N8N_SECURE_COOKIE=false, N8N_BIND=0.0.0.0.
N8N_HOST=jsur.site
N8N_PROTOCOL=https
# Subpath n8n di proxy, diawali dan diakhiri "/"
N8N_PATH=/n8n/
# URL publik n8n untuk webhook Meta (callback: <WEBHOOK_URL>webhook/whatsapp), diakhiri "/"
WEBHOOK_URL=https://jsur.site/n8n/
# URL editor n8n (link di email/UI)
N8N_EDITOR_BASE_URL=https://jsur.site/n8n/
# Jumlah reverse proxy di depan n8n (nginx = 1), untuk membaca X-Forwarded-*
N8N_PROXY_HOPS=1
# true = login n8n hanya lewat HTTPS
N8N_SECURE_COOKIE=true
# Dipakai script di host (simulate-inbound, upsert-order, import-chat-export)
N8N_PUBLIC_URL=https://jsur.site/n8n
N8N_WEBHOOK_URL=https://jsur.site/n8n/

# Port di host dan alamat bind. 127.0.0.1 = hanya bisa diakses nginx di mesin yang sama.
N8N_BIND=127.0.0.1
N8N_PORT=5678
DASHBOARD_BIND=0.0.0.0
DASHBOARD_PORT=4000
# Subpath dashboard tiket di proxy (default "/")
DASHBOARD_BASE_PATH=/
# PostgREST dan Qdrant tanpa autentikasi: biarkan di 127.0.0.1, jangan diproxy ke internet
DB_API_BIND=127.0.0.1
DB_API_PORT=3002
DB_API_PUBLIC_URL=
QDRANT_BIND=127.0.0.1
QDRANT_PORT=6333
MOCK_WHATSAPP_BIND=127.0.0.1
MOCK_WHATSAPP_PORT=8080
NGROK_INSPECTOR_PORT=4040

# Tunnel ngrok di dalam compose (service "tunnel"). Kosong karena n8n lewat nginx;
# bila memakai ngrok, tambahkan COMPOSE_PROFILES=tunnel, NGROK_AUTHTOKEN dan NGROK_DOMAIN.
COMPOSE_PROFILES=
GENERIC_TIMEZONE=Asia/Jakarta


# Semua model AI lewat OpenRouter (https://openrouter.ai/keys). Model chat dipakai untuk
# keputusan AUTO_REPLY/ESCALATE, ringkasan order, label chat, dan ringkasan dashboard.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b
OPENROUTER_API_KEY=ganti_dengan_api_key_openrouter
# Model embedding knowledge (Qdrant). Ganti model = buat collection baru:
#   node scripts/reembed-knowledge.mjs <collection_lama> <collection_baru>
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small

# Alamat dari host (scripts/doctor.mjs). Di dalam compose, n8n otomatis memakai
# http://qdrant:6333 dan http://db-api:3000.
QDRANT_URL=http://localhost:6333
DB_API_URL=http://localhost:3002

# Versi Graph API Meta
WHATSAPP_GRAPH_VERSION=v23.0

# Vector database
QDRANT_COLLECTION=wa_knowledge_openrouter
QDRANT_SCORE_THRESHOLD=0.55

# Token WhatsApp (access token, Business Account ID, verify token) tidak di .env:
# isi di n8n, credential "WhatsApp account" dan trigger WhatsApp.
# App secret Meta opsional, untuk cek tanda tangan webhook masuk.
WHATSAPP_APP_SECRET=

# Nomor hanya angka dengan kode negara, tanpa tanda +. Nomor ini mengirim perintah
# admin dan balasan tiket dari akun WhatsApp pribadi owner ke nomor bisnis.
OWNER_PHONE=628xxxxxxxxxx
OWNER_NAME=Owner

# Melindungi webhook admin untuk impor chat dan sinkronisasi order.
IMPORT_API_KEY=ganti_kunci_import_acak

# Dashboard admin NodeJS (port 4000). Balasan tiket dikirim lewat webhook n8n
# dashboard-send memakai credential "WhatsApp account", jadi tidak butuh token di sini.
# Rahasia bersama dashboard tiket -> webhook n8n dashboard-send (openssl rand -hex 24)
DASHBOARD_SEND_SECRET=ganti_rahasia_dashboard
